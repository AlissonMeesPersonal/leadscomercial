{
  "manifest_version": 3,
  "name": "Leads Comercial → Scale",
  "version": "2.7.2",
  "description": "Preenche leads no Scale e completa o template de cobrança com dados do relatório de inadimplentes.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://leadscomercial.vercel.app/*",
    "https://scale.26fit.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leadscomercial.vercel.app/*",
        "https://scale.26fit.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
